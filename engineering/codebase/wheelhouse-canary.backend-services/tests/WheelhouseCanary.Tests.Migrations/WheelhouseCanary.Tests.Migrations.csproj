<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Migrator-engine suite: the bespoke SQL migrator's apply / idempotency / rollback over the embedded
    Migrations/NNN/*.sql, asserted against a real PostgreSQL (Docker). No HTTP, no EF model.
    Rides the SDK Testing.Data harness (MigratorHarness over the drop-schema MigratorPostgresFixture).
  -->
  <ItemGroup>
    <PackageReference Include="WoW2.Sdk.Beta.Be.Testing.Data" />
    <PackageReference Include="WoW2.Sdk.Beta.Be" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\WheelhouseCanary.Persistence\WheelhouseCanary.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
