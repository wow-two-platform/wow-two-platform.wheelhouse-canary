# Build output
**/bin/
**/obj/
**/dist/
**/.vite/
node_modules/
*.tsbuildinfo
**/logs/

# Settings + secrets: appsettings.Local.json is this machine's, read by an IDE run only; appsettings.Target.json a
# target's, mounted at deploy; appsettings.Machine.json the machine file's retired name
**/appsettings.Local.json
**/appsettings.Target.json
**/appsettings.Machine.json
.env

# Built SPA copied into the API host (regenerated by `pnpm run deploy` or any non-BuildSpa=false build)
engineering/codebase/wheelhouse-canary.backend-services/WheelhouseCanary.Api/wwwroot/*
!engineering/codebase/wheelhouse-canary.backend-services/WheelhouseCanary.Api/wwwroot/.gitkeep

# IDE / OS
.idea/
.vs/
.vscode/*
*.user
.DS_Store
